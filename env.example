NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_banking
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (used to send OTP verification codes). Leave blank to fall back to
# console-logging the OTP instead of sending a real email (handy for dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@mernbank.test

# Comma-separated list of admin emails auto-promoted to role "admin" on registration
ADMIN_EMAILS=admin@mernbank.test
